  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 4,
            "pattern": "^[a-zA-Z0-9_\\-]+$",
            "title": "Session Id",
            "description": "会话ID：4-64位字母数字下划线连字符"
          },
          "scene": {
            "type": "string",
            "title": "Scene",
            "default": "gaokao"
          },
          "message": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Message"
          },
          "slots": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slots"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "groups": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Groups"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "KnowledgeSearchRequest"
      },
      "NextQuestionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "round_count": {
            "type": "integer",
            "title": "Round Count"
          },
          "is_complete": {
            "type": "boolean",
            "title": "Is Complete"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "question",
          "round_count",
          "is_complete"
        ],
        "title": "NextQuestionResponse"
      },
      "OnboardingRequest": {
        "properties": {
          "step": {
            "type": "integer",
            "title": "Step"
          },
          "data": {
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "step",
          "data"
        ],
        "title": "OnboardingRequest"
      },
      "ProfileResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "profile": {
            "type": "object",
            "title": "Profile"
          },
          "is_complete": {
            "type": "boolean",
            "title": "Is Complete"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "profile",
          "is_complete",
          "missing_fields"
        ],
        "title": "ProfileResponse"
      },
      "ProfileUpdateRequest": {
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Field"
          },
          "value": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "field",
          "value"
        ],
        "title": "ProfileUpdateRequest"
      },
      "SkipFieldRequest": {
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "field"
        ],
        "title": "SkipFieldRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}