**/*.db*
backups/
logs/
data/reports/
frontend/test-results/
test-results/
playwright-report/
htmlcov/
.coverage*
frontend/node_modules/
frontend/dist/

# The future synthetic demo dataset is the only data allowed in images.
!data/sample/
!data/sample/**
