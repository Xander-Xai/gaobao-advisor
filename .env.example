# 雪峰Agent v2.0 配置文件
# 复制此文件为 .env，填入你的 API Key

# ── 方式一：手动指定（推荐）──
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# DeepSeek 可选模型：deepseek-chat（通用）/ deepseek-v4-pro（最强）/ deepseek-v4-flash（性价比）
# ⚠️ v2.0 表达引擎需要 32B+ 模型才能正确执行，7B 模型理解力不足

# ── 方式二：用 LLM_PROVIDER 快捷切换 ──
# （注意：用 LLM_PROVIDER 时删掉上面 LLM_MODEL 那行，否则不生效）
# LLM_PROVIDER=deepseek   # DeepSeek（推荐）
# LLM_PROVIDER=qwen       # 通义千问（推荐 Qwen2.5-32B-Instruct 或以上）
# LLM_PROVIDER=glm        # 智谱 GLM-4
# LLM_PROVIDER=moonshot   # Moonshot
# LLM_PROVIDER=openai     # GPT-4o
# LLM_PROVIDER=ollama     # 本地模型（免费离线）

# ── 数据库配置（可选） ──
# 默认使用本地 SQLite（data/gaokao.db），无需额外配置
# 如需使用其他数据库，取消注释并修改：
# DATABASE_URL=sqlite:///data/gaokao.db
# DATABASE_URL=mysql+pymysql://user:pass@localhost/gaokao
# DATABASE_URL=postgresql://user:pass@localhost/gaokao

# ── 联网搜索开关 ──
ENABLE_SEARCH=false

# ── 知识检索引擎（RAG） ──
ENABLE_RAG_KB=true   # 启用向量+关键词混合检索（关闭则使用旧的全量注入）
# EMBEDDING_PROVIDER=openai     # embedding 来源：openai / dashscope / ollama
# EMBEDDING_MODEL=text-embedding-3-small  # embedding 模型
# EMBEDDING_FALLBACK=keyword    # embedding 失败时降级策略
# EMBEDDING_CACHE_SIZE=100      # 查询 embedding 缓存大小（LRU）

# --- DashScope Voice (NEW) ---
DASHSCOPE_ASR_API_KEY=
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_CHAT_MODEL=qwen-plus

# --- Feature Flags (NEW) ---
VOICE_ENABLED=true
SCENE_ENABLED=true
