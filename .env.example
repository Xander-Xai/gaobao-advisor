# ============================================================
# gaobao-advisor 配置模板
# ============================================================
# 使用方法：
#   1. cp .env.example .env
#   2. 编辑 .env，填入你的 API Key
#   3. docker-compose up
#
# 🔐 安全提示: .env 已被 .gitignore 排除，不会提交到 git
# ============================================================

# 默认是无需密钥、不会联网的社区演示模式。
APP_ENV=development

# ── LLM Provider 配置 ──────────────────────────────────────
# 方式一：手动指定（推荐）
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# 方式二：用 LLM_PROVIDER 快捷切换
# LLM_PROVIDER=demo           # 无密钥合成演示（默认）
# LLM_PROVIDER=ollama         # 本地模型
# LLM_PROVIDER=deepseek       # DeepSeek
# LLM_PROVIDER=qwen           # 通义千问
# LLM_PROVIDER=agnes-flash-1  # Agnes Flash
# LLM_PROVIDER=glm-4          # 智谱 GLM-4
# LLM_PROVIDER=moonshot       # Moonshot
# LLM_PROVIDER=openai         # GPT-4o

# 默认不连接任何外部或本地模型服务
LLM_PROVIDER=demo
LLM_BASE_URL=demo://local
LLM_MODEL=gaobao-demo

# ── 联网搜索开关 ─────────────────────────────────────────
ENABLE_SEARCH=false

# ── RAG 知识检索引擎 ──────────────────────────────────────
ENABLE_RAG_KB=false
RAG_EMBEDDING_PROVIDER=keyword
# 启用远程 embedding 时再设置对应密钥和模型。

# ── 语音配置（DashScope） ────────────────────────────────
GAOBAO__VOICE__API_KEY=
GAOBAO__VOICE__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GAOBAO__VOICE__MODEL=qwen-plus
GAOBAO__VOICE__MAX_TOKENS=500

# ── Feature Flags ─────────────────────────────────────────
VOICE_ENABLED=false
SCENE_ENABLED=true

# ── CORS 配置（生产环境必填） ────────────────────────────
# CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ── Session 签名密钥（生产环境必填） ─────────────────────
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# 不填则每次重启随机生成，多 worker 下 session token 将失效
SESSION_SECRET=

# ── 高级配置（可选，有默认值） ───────────────────────────
# GAOBAO__VOICE__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GAOBAO__EMBEDDING__BASE_URL=https://api.siliconflow.cn/v1
# GAOBAO__VECTOR__INDEX_DIR=data/vector_index
# GAOBAO__REPORTS__DIR=data/reports
# GAOBAO__DATA_DIR=data
# GAOBAO__RATE_LIMIT__RATE=20
# GAOBAO__RATE_LIMIT__BURST=40
