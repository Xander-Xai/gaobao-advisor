# gaobao-advisor 配置文件
# 复制本文件为 .env 后按需填写。默认配置无需任何 API Key 即可启动：
# 使用离线合成数据（SYNTHETIC_DEMO），知识检索（RAG）默认启用随仓原创合成语料。

# ── LLM 配置（可选；不填则进入离线 DEMO 模式，使用确定性模板应答） ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 方式二：用 LLM_PROVIDER 快捷切换（用 LLM_PROVIDER 时删掉上面的 LLM_MODEL）
# LLM_PROVIDER=deepseek   # DeepSeek
# LLM_PROVIDER=qwen       # 通义千问（Qwen2.5-32B-Instruct 或以上）
# LLM_PROVIDER=glm        # 智谱 GLM-4
# LLM_PROVIDER=moonshot   # Moonshot
# LLM_PROVIDER=openai     # GPT-4o
# LLM_PROVIDER=ollama     # 本地模型（免费离线）

# ── 数据库 ──
# 默认使用随仓库生成的合成演示库 data/demo.db（见 scripts/seed_demo_data.py）。
# 如需使用其他数据库，取消注释并修改（仅支持 sqlite / mysql+pymysql，
# 其他 scheme 会 fail-closed，不会静默回退 SQLite）：
# DATABASE_URL=sqlite:///data/demo.db
# DATABASE_URL=mysql+pymysql://user:pass@localhost/gaokao
#
# MySQL 可选完整栈（见 docker-compose.full.yml / scripts/setup_full_env.py）：
# AUTO_MIGRATE=true          # API 启动时执行 Alembic
# DB_AUTO_CREATE=false       # 仅 demo 容器可设为 true；生产应使用迁移

# ── 联网搜索开关（默认关闭；无第三方检索授权） ──
ENABLE_SEARCH=false

# ── 第三方数据抓取（默认关闭）──
# 关闭时 legacy 查询只返回本地数据库结果，不会静默回退到抓取第三方站点。
ENABLE_OUTBOUND_FETCH=false

# ── 知识检索引擎（RAG） ──
# 公开演示默认开启：仓库自带原创合成语料 knowledge/synthetic_demo（CC0），
# 启动时自动完成语料完整性校验并初始化，无需任何 API Key 即可检索。
# 语料缺失/损坏时 fail-closed：/api/v1/health 返回 RAG_ERROR，检索请求报错，
# 不会静默退化为无证据的模型回答。若要关闭，设为 false。
ENABLE_RAG_KB=true
# RAG Embedding Provider: keyword (默认离线 BM25) / siliconflow / openai / dashscope / ollama
# 默认且唯一的离线路径是 keyword；只有显式设置 RAG_EMBEDDING_PROVIDER 才会启用
# 需要网络/付费的向量 Provider。配置 LLM Key（如 OPENAI_API_KEY）不会自动切换检索 Provider。
# RAG_EMBEDDING_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=sk-your-key-here
# RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5  # 1024 维

# ── 真实数据环境启用 RAG 的前置条件 ──
# 使用真实招生数据前，必须配置已获授权的语料并通过完整性检查，再开启 RAG。
# 未获授权的第三方语料不得随仓库分发或用于演示。

# ── 语音（默认关闭；需自备 DashScope 凭据） ──
DASHSCOPE_ASR_API_KEY=
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_CHAT_MODEL=qwen-plus
VOICE_ENABLED=false

# ── 场景开关 ──
SCENE_ENABLED=true

# ── CORS 配置（生产环境必填） ──
# 逗号分隔的前端域名；不填则仅允许 localhost:3080/8501/8000
# CORS_ORIGINS=https://your-domain.com

# ── Session 签名密钥（生产环境必填） ──
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# APP_ENV=production 时若未设置，服务在启动阶段直接失败（不会等到请求时）。
# 开发环境留空则持久化到 data/.session_secret，供重启/本地多 worker 复用。
SESSION_SECRET=

# ── 运营后台鉴权（可选；不配置则后台入口返回 503，不会默认放行） ──
# 推荐用脚本生成：python scripts/setup_admin_env.py
# 或手动生成密码哈希：python scripts/hash_admin_password.py --json
# 生产环境必须显式设置 ADMIN_TOKEN_SECRET（>=32 字符），且不得使用 ADMIN_PASSWORD 明文。
# ADMIN_USERS_JSON=[{"username":"operator","password_hash":"pbkdf2_sha256$...","role":"operator"}]
# ADMIN_USERNAME=operator
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$...
# ADMIN_TOKEN_SECRET=
# ADMIN_TOKEN_TTL_SECONDS=28800
#
# 管理员安全后端：auto（有 REDIS_URL 用 Redis；开发无 Redis 用内存；生产必须 Redis）
# memory 仅限本地；production + memory 会在启动时 fail-closed。
# ADMIN_RATE_LIMIT_BACKEND=auto
# ADMIN_RATE_LIMIT_NAMESPACE=gaobao:admin:ratelimit:v1
#
# 可信反向代理：默认空，忽略 X-Forwarded-For。只有直接 peer 在此 CIDR 内才解析转发链。
# 生产 Nginx 示例：ADMIN_TRUSTED_PROXIES=172.30.0.10/32
# ADMIN_TRUSTED_PROXIES=
# 公共接口（聊天限流）使用 TRUSTED_PROXIES；未设置时回退到 ADMIN_TRUSTED_PROXIES。
# TRUSTED_PROXIES=172.30.0.10/32

# 数据质检任务模式：auto（优先 Redis，开发环境不可用时显式内联降级）/ async / inline / disabled
QUALITY_TASK_MODE=auto
# REDIS_URL=redis://localhost:6379/0
# QUALITY_QUEUE_KEY=gaobao:quality:jobs
